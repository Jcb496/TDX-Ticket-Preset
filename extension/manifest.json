{
  "manifest_version": 3,
  "name": "TDX Account & Access Presets",
  "version": "3.0.0",
  "description": "TDX ticket presets with centrally managed configuration and local custom presets.",
  "permissions": [
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://tdx.vanderbilt.edu/TDNext/Apps/34/Tickets/Edit*"
      ],
      "js": [
        "default-config.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
